# Maintainer: Mike Smith <mike@example.com>
#
# Release package: builds the tagged version from the repository.
# For a package that tracks the latest commit, see PKGBUILD-git beside this.
#
# Before the first upload:
#   1. Create the repository at the `url` below and push a `v0.1.0` tag.
#   2. Put your real name and address in the Maintainer line.
#   3. makepkg --printsrcinfo > .SRCINFO
#   4. makepkg -si    # builds, runs the test suite, installs

pkgname=omaverse
pkgver=0.1.0
pkgrel=1
pkgdesc="Outline scripture, annotate the original languages, and diagram sentences — in plain files"
arch=('x86_64' 'aarch64')
url="https://github.com/mikefsm/omaverse"
license=('MIT')
depends=('gtk4' 'libadwaita' 'enchant' 'cairo' 'pango' 'glib2')
makedepends=('cargo' 'git')
optdepends=(
  'hunspell-en_us: spell checking in outlines'
  # SBL BibLit, SBL Greek and SBL Hebrew are not packaged for Arch. Omaverse
  # falls back to the system serif without them; see the README for where the
  # Society of Biblical Literature publishes them.
)
source=("git+$url.git#tag=v$pkgver")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen --release
}

package() {
  cd "$pkgname"
  install -Dm0755 target/release/omaverse "$pkgdir/usr/bin/omaverse"
  install -Dm0644 data/org.mikefsm.omaverse.desktop \
    "$pkgdir/usr/share/applications/org.mikefsm.omaverse.desktop"
  install -Dm0644 data/org.mikefsm.omaverse.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/org.mikefsm.omaverse.svg"
  install -Dm0644 data/org.mikefsm.omaverse.metainfo.xml \
    "$pkgdir/usr/share/metainfo/org.mikefsm.omaverse.metainfo.xml"
  install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm0644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
